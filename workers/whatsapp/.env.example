# Where the queue lives.
CONTROL_PLANE_URL=https://commerce-control-plane-api.vercel.app

# A FULL merchant key. A pending message carries the payer's phone number, so
# this queue is not readable with a browse key — and this file therefore
# belongs on a server you control, never on a laptop or in a repository.
COMMERCE_API_KEY=ccp_live_...

# Names the folder the WhatsApp session is saved into. Changing it forces a
# new QR scan, so leave it alone once it works.
WA_SESSION=shop

# How often to ask for pending messages. Sixty seconds is a receipt arriving
# within a minute of payment, which reads as immediate to a shopper.
POLL_SECONDS=60

# Pause between sends. WhatsApp throttles a sender that blasts.
SEND_GAP_MS=1000

# Prefixed to bare ten-digit numbers. Razorpay reports E.164 already; this is
# for a merchant whose own records store ten digits.
COUNTRY_CODE=91
