# Copy to .env and fill in. Never commit .env.

ENVIRONMENT=development
LOG_LEVEL=INFO

# ---------------------------------------------------------------- database
# PostgreSQL. Supabase, Neon, RDS or a local instance all work.
# Supabase: Project Settings > Database > Connection string > URI
DATABASE_URL=postgresql://user:password@host:5432/dbname
DB_POOL_MIN=1
DB_POOL_MAX=10

# Separate throwaway database for the test suite.
TEST_DATABASE_URL=postgresql://user:password@host:5432/dbname_test

# ---------------------------------------------------------------- payments
# dashboard.razorpay.com in TEST MODE > Settings > API Keys
# Leave blank to run against the built-in simulator.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Settings > Webhooks. Required in production; without it signatures cannot
# be verified and the service refuses to start.
RAZORPAY_WEBHOOK_SECRET=

# ---------------------------------------------------------------- retrieval
# Leave PINECONE_API_KEY blank to use PostgreSQL full-text search instead.
PINECONE_API_KEY=
PINECONE_INDEX=merchant-catalog
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
PINECONE_EMBED_MODEL=llama-text-embed-v2

# ---------------------------------------------------------------- model
# DeepSeek proposes what to sell. It only ever returns a proposal, never a
# price, so the model is never trusted with the merchant's economics.
# Leave the key blank to run on the deterministic bundler alone — which is
# also what any model failure falls back to.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ---------------------------------------------------------------- policy
# Defaults for merchants that have not set their own limits.
DEFAULT_MAX_DISCOUNT_BPS=1500
DEFAULT_MIN_MARGIN_BPS=800
RESERVATION_TTL_SECONDS=600

# ---------------------------------------------------------------- workers
RECONCILE_SWEEP_SECONDS=120
RECONCILE_STALE_AFTER_SECONDS=180
EXPIRY_SWEEP_SECONDS=60

# ---------------------------------------------------------------- limits
RATE_LIMIT_PER_MINUTE=120
